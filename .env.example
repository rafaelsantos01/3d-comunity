# Doações via Pix (página /apoie). Lidas no build: depois de trocar, faça um novo deploy.
# Sem chave, nome ou cidade válidos, a página mostra "doações temporariamente indisponíveis".

# Chave Pix (e-mail, telefone +55..., CPF/CNPJ ou chave aleatória), até 77 caracteres
NEXT_PUBLIC_PIX_CHAVE=123e4567-e12b-12d1-a456-426655440000
# Nome do beneficiário: acentos e símbolos são removidos e o texto é cortado em 25 caracteres
NEXT_PUBLIC_PIX_NOME=Fulano de Tal
# Cidade do beneficiário: mesma normalização, cortada em 15 caracteres
NEXT_PUBLIC_PIX_CIDADE=BRASILIA
# Identificador da transação (opcional): até 25 letras/números. Padrão: ***
NEXT_PUBLIC_PIX_TXID=
